# Anthropic — get your key at console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tavily — get your key at tavily.com (free tier, no credit card)
TAVILY_API_KEY=your_tavily_api_key_here

# Product Hunt — create a token at api.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=your_producthunt_developer_token_here

# ChromaDB — local vector store, no key needed, just a folder path
CHROMA_PERSIST_DIR=./chroma_db