# Anthropic — get your key at console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tavily — get your key at tavily.com (free tier, no credit card)
TAVILY_API_KEY=your_tavily_api_key_here

# Reddit — register your app at reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=MarketMap/1.0 by your_reddit_username_here

# ChromaDB — local vector store, no key needed, just a folder path
CHROMA_PERSIST_DIR=./chroma_db